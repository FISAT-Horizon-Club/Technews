# Supabase project credentials
#
# 1. Copy this file to `.env.local`:  cp .env.example .env.local
# 2. Fill in the values below using your Supabase project settings:
#    Project Settings -> API
# 3. Never commit `.env.local` (it is already in .gitignore).
#
# Use the "anon public" key only. Never use the service_role / secret key here.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
